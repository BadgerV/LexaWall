<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!--
        Minimal launcher icon:
        Clean serif "L" with a small hummingbird-wing flourish
        rising from the top of the stem.
        Centered within the 66dp adaptive-icon safe zone.
    -->

    <!-- Serif L – vertical stem -->
    <path
        android:fillColor="#C9A74A"
        android:pathData="M 38,30 L 43,30 L 43,68 L 38,68 Z" />

    <!-- Serif L – horizontal foot -->
    <path
        android:fillColor="#C9A74A"
        android:pathData="M 38,68 L 70,68 L 70,73 L 38,73 Z" />

    <!-- Thin serif cap at top of stem -->
    <path
        android:fillColor="#C9A74A"
        android:pathData="M 35,28 L 46,28 L 46,30 L 35,30 Z" />

    <!-- Thin serif base accent -->
    <path
        android:fillColor="#C9A74A"
        android:pathData="M 35,73 L 73,73 L 73,75 L 35,75 Z" />

    <!-- Hummingbird wing flourish – sweeping curve off the stem top -->
    <path
        android:fillColor="#D4B157"
        android:pathData="
            M 46,30
            C 50,23 58,20 66,22
            C 62,25 55,28 48,30
            Z" />

    <!-- Tiny bird-eye dot -->
    <path
        android:fillColor="#1A1A2E"
        android:pathData="M 62.5,22 a 1.2,1.2 0 1,1 2.4,0 a 1.2,1.2 0 1,1 -2.4,0 z" />
